{
  "name": "docvi",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.10.1",
  "description": "docvi：任意 Markdown 目录 → 可浏览 / 可搜索 / 可交互的文档应用（单一渲染层 · 桌面与容器两宿主）",
  "repository": {
    "type": "git",
    "url": "https://github.com/OneFanki/docvi.git"
  },
  "type": "module",
  "scripts": {
    "build:plugins": "node scripts/build-plugins.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:baseline": "node scripts/lint.mjs --update",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "node scripts/verify.mjs",
    "commitlint": "commitlint",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.components.json",
    "docvi:i18n:check": "node scripts/check-docvi-i18n.mjs",
    "docvi:dev": "pnpm --filter @docvi/desktop dev",
    "docvi:build": "pnpm --filter @docvi/desktop build",
    "docvi:typecheck": "pnpm --filter @docvi/desktop typecheck",
    "docvi:dist": "pnpm --filter @docvi/desktop build && node scripts/build-plugins.mjs && node scripts/assemble-plugins.mjs --out apps/desktop/build/plugins && electron-builder --project apps/desktop --config electron-builder.yml",
    "docvi:build:web": "pnpm --filter @docvi/desktop exec vite build --config vite.web.config.ts",
    "scan:open-source": "node scripts/scan-open-source.mjs",
    "skills:check": "node scripts/check-skills.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "site:build": "node scripts/build-site.mjs --out site-build"
  },
  "dependencies": {
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "mermaid": "^11.17.2",
    "minisearch": "^7.2.0",
    "shiki": "^4.5.0",
    "vue": "^3.5.41",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.3.10"
  }
}
