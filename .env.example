# 复制为 .env 后填写。.env 不要提交（已在 .gitignore）。

# 运维 token（必填）：管理页/面板与全部运维 API 的凭证
OPS_TOKEN=change-me-to-a-long-random-string

# git 凭证（访问私有仓库时注入）：形如 https://user:token@git.example.com
# 可多行。公开仓库留空即可。
GIT_CREDENTIALS=

# 镜像版本（本地构建留默认；CI 构建时覆盖为镜像 tag）
PLATFORM_VERSION=local

# 容器时区（影响清理 cron 与日志时间；缺省 Asia/Shanghai）
TZ=Asia/Shanghai

# 临时分享（可选）：本机目录 → 容器内共享根。填一个本机绝对路径（如设计文档目录），
# 重启后即可在运维页创建分享、生成 /s/<id>/ 链接给局域网同事临时查看。
SHARE_HOST_DIR=./share
